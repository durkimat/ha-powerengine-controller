# PowerEngine dashboard: managed by the PowerEngine app.
# This file is rewritten whenever PowerEngine is updated; local edits will be lost.
# Needs: Power Flow Card Plus and ApexCharts Card (HACS). See docs/INSTALL.md, Step 5.
title: PowerEngine
views:
  - title: Monitoring
    path: monitoring
    icon: mdi:lightning-bolt
    type: sections
    max_columns: 3
    sections:
      - type: grid
        column_span: 3
        cards:
          - type: markdown
            grid_options: {columns: full}
            content: |-
              {% set t = state_attr('sensor.pe_state_summary', 'text') or states('sensor.pe_state_summary') %}
              {% set parts = t.split('. ', 1) %}
              **{{ parts[0] }}**{% if parts | count > 1 %} {{ parts[1] }}{% endif %}
          - type: tile
            entity: sensor.pe_state_operation_mode
            name: Mode
            grid_options: {columns: 4}
          - type: tile
            entity: sensor.pe_state_decision
            name: Decision
            grid_options: {columns: 4}
          - type: tile
            entity: sensor.pe_state_battery_soc
            name: Battery
            grid_options: {columns: 4}
            features:
              - type: bar-gauge
      - type: grid
        column_span: 2
        cards:
          - type: heading
            heading: Energy flow
          - type: custom:power-flow-card-plus
            grid_options: {columns: full}
            watt_threshold: 1000
            kw_decimals: 1
            min_flow_rate: 1
            max_flow_rate: 6
            clickable_entities: true
            display_zero_lines:
              mode: transparency
              transparency: 70
            entities:
              battery:
                entity: sensor.pe_state_battery_power
                state_of_charge: sensor.pe_state_battery_soc
              grid:
                entity: sensor.pe_state_grid_power
              solar:
                entity: sensor.pe_state_solar_power
                display_zero_state: true
              home:
                entity: sensor.pe_state_house_power
                override_state: true
              individual:
                - entity: sensor.pe_state_ev_power
                  name: Car
                  icon: mdi:car-electric
                  display_zero: true
                  display_zero_tolerance: 50
      - type: grid
        cards:
          - type: heading
            heading: Now
          - type: markdown
            content: |-
              {% set imp = state_attr('sensor.pe_state_import_rate', 'pence') %}
              {% set until = state_attr('sensor.pe_state_import_rate', 'until') %}
              {% set nxt = state_attr('sensor.pe_state_import_rate', 'next_rate_pence') %}
              {% set exp = state_attr('sensor.pe_state_export_rate', 'pence') %}
              **Import** {{ imp if imp is not none else '–' }}p
              {%- if state_attr('sensor.pe_state_import_rate', 'in_smart_slot') %} (smart slot){% endif %}
              {%- if until and nxt is not none %}, then {{ nxt }}p from {{ until }}{% endif %}

              **Export** {{ exp if exp is not none else '–' }}p
          - type: tile
            entity: sensor.pe_state_ev
            name: Car
          - type: tile
            entity: sensor.pe_state_smart_charge
            name: EDF smart charge
          - type: tile
            entity: sensor.pe_state_axle
            name: Axle
          - type: tile
            entity: sensor.pe_state_free_power
            name: Free power
          - type: markdown
            content: |-
              {% set t = state_attr('sensor.pe_state_solar_power', 'forecast_today_kwh') %}
              {% set m = state_attr('sensor.pe_state_solar_power', 'forecast_tomorrow_kwh') %}
              **Solar forecast** today {{ t if t is not none else '–' }} kWh · tomorrow {{ m if m is not none else '–' }} kWh
      - type: grid
        column_span: 3
        cards:
          - type: heading
            heading: Activity
          - type: markdown
            grid_options: {columns: full}
            content: |-
              {% set entries = state_attr('sensor.pe_state_activity', 'entries') or [] %}
              {%- if entries | count == 0 %}No decisions yet.{% endif %}
              {%- for e in entries[:8] %}
              - **{{ e.hhmm }}** {{ e.text }}
              {%- endfor %}
      - type: grid
        column_span: 3
        cards:
          - type: heading
            heading: Last 24 hours
          - type: history-graph
            grid_options: {columns: full}
            hours_to_show: 24
            entities:
              - entity: sensor.pe_state_solar_power
                name: Solar
              - entity: sensor.pe_state_house_power
                name: House
              - entity: sensor.pe_state_battery_power
                name: Battery (+ discharging)
              - entity: sensor.pe_state_grid_power
                name: Grid (+ importing)
              - entity: sensor.pe_state_ev_power
                name: Car
          - type: history-graph
            grid_options: {columns: full}
            hours_to_show: 24
            entities:
              - entity: sensor.pe_state_battery_soc
                name: Battery % (real)
              - entity: sensor.pe_state_sim_soc
                name: Battery % (PowerEngine simulated)
      - type: grid
        column_span: 3
        cards:
          - type: heading
            heading: PowerEngine health
            heading_style: subtitle
          - type: tile
            entity: sensor.pe_diag_heartbeat
            name: Heartbeat
            grid_options: {columns: 4}
          - type: tile
            entity: binary_sensor.pe_diag_config_ok
            name: Config OK
            grid_options: {columns: 4}
          - type: tile
            entity: sensor.pe_diag_version
            name: Version
            grid_options: {columns: 4}
  - title: Plan
    path: plan
    icon: mdi:calendar-clock
    type: sections
    max_columns: 3
    sections:
      - type: grid
        column_span: 3
        cards:
          - type: markdown
            grid_options: {columns: full}
            content: |-
              {% set made = states('sensor.pe_plan') -%}
              **{{ state_attr('sensor.pe_plan_headline', 'text') or 'No plan yet.' }}**

              Plan made {{ as_timestamp(made) | timestamp_custom('%H:%M') if made not in ['unknown', 'unavailable', ''] else '–' }}
              · re-plans every 5 minutes and when prices, slots or events change
              · house load learned from {{ state_attr('sensor.pe_plan', 'load_profile_days') or 0 }} days of history
              {%- if (state_attr('sensor.pe_plan', 'load_profile_days') or 0) < 2 %}
              · **the load forecast is still learning**, so treat this plan as rough for the first day or two{% endif %}
              {%- macro money(v) -%}{% set v = v | float(0) %}{{ ('earns £%.2f' | format(-v)) if v < -0.005 else ('costs £%.2f' | format(v)) }}{%- endmacro %}
              · this plan {{ money(state_attr('sensor.pe_plan', 'cost')) }} over the period; plain self-use {{ money(state_attr('sensor.pe_plan', 'baseline_cost')) }}
              {%- if state_attr('sensor.pe_plan', 'estimated_prices_from') %}
              · prices after {{ as_timestamp(state_attr('sensor.pe_plan', 'estimated_prices_from')) | timestamp_custom('%a %H:%M') }} are estimated (not yet published){% endif %}
          - type: custom:apexcharts-card
            grid_options: {columns: full, rows: auto}
            graph_span: 36h
            span:
              start: minute
            now:
              show: true
              label: Now
            header:
              show: true
              title: Next 36 hours
              show_states: false
            apex_config:
              chart: {height: 380}
              legend: {show: true}
              tooltip: {shared: true}
            yaxis:
              - id: soc
                min: 0
                max: 100
                decimals: 0
                apex_config: {title: {text: "Battery %"}}
              - id: price
                opposite: true
                min: 0
                decimals: 0
                apex_config: {title: {text: "p/kWh"}}
              - id: kwh
                opposite: true
                min: 0
                decimals: 1
                apex_config: {title: {text: "kWh per half-hour"}}
            series:
              - entity: sensor.pe_plan
                name: Battery (planned)
                yaxis_id: soc
                type: line
                color: "#43a047"
                stroke_width: 3
                extend_to: false
                data_generator: |
                  const s = entity.attributes.series || {t: []};
                  return s.t.map((t, i) => [new Date(t).getTime() + 1800000, s.soc[i]]);
              - entity: sensor.pe_plan
                name: Import price
                yaxis_id: price
                type: line
                curve: stepline
                color: "#fb8c00"
                stroke_width: 2
                extend_to: false
                data_generator: |
                  const s = entity.attributes.series || {t: []};
                  return s.t.map((t, i) => [new Date(t).getTime(), s.price_p[i]]);
              - entity: sensor.pe_plan
                name: Solar forecast (kWh)
                yaxis_id: kwh
                type: area
                color: "#fdd835"
                opacity: 0.3
                extend_to: false
                data_generator: |
                  const s = entity.attributes.series || {t: []};
                  return s.t.map((t, i) => [new Date(t).getTime(), s.solar_kwh[i]]);
              - entity: sensor.pe_plan
                name: House load forecast (kWh)
                yaxis_id: kwh
                type: line
                color: "#9e9e9e"
                stroke_width: 1
                extend_to: false
                data_generator: |
                  const s = entity.attributes.series || {t: []};
                  return s.t.map((t, i) => [new Date(t).getTime(), s.load_kwh[i]]);
              - entity: sensor.pe_plan
                name: Grid charge (kWh)
                yaxis_id: kwh
                type: column
                color: "#1e88e5"
                extend_to: false
                data_generator: |
                  const s = entity.attributes.series || {t: []};
                  return s.t.map((t, i) => [new Date(t).getTime(), s.charge_kwh[i]]);
              - entity: sensor.pe_plan
                name: Axle export (kWh)
                yaxis_id: kwh
                type: column
                color: "#e53935"
                extend_to: false
                data_generator: |
                  const s = entity.attributes.series || {t: []};
                  return s.t.map((t, i) => [new Date(t).getTime(), s.discharge_kwh[i]]);
      - type: grid
        column_span: 3
        cards:
          - type: heading
            heading: Actions
          - type: markdown
            grid_options: {columns: full}
            content: |-
              | Time | Action | Target | Price | Battery | Why |
              |---|---|---|---|---|---|
              {%- for w in state_attr('sensor.pe_plan', 'windows') or [] %}
              | {{ (w.day ~ ' ') if w.day }}{{ w.from }}–{{ w.to }} | **{{ w.action | replace('_', '-') }}** | {{ (w.target_soc | int | string ~ '%') if w.target_soc else '–' }} | {{ w.price }}{{ ' (est.)' if w.estimated else '' }} | {{ w.soc_start }}% → {{ w.soc_end }}% | {{ w.reason }} |
              {%- endfor %}
  - title: Config
    path: config
    icon: mdi:cog
    panel: true
    cards:
      - type: custom:powerengine-config-card
